{
    "name": "doppar/twig-bridge",
    "description": "Twig integration bridge for Doppar Framework",
    "type": "library",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/doppar/twig-bridge/issues",
        "source": "https://github.com/doppar/twig-bridge"
    },
    "authors": [
        {
            "name": "Pierre S"
        }
    ],
    "autoload": {
        "psr-4": {
            "Doppar\\TwigBridge\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Doppar\\TwigBridge\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.1",
        "doppar/framework": "4.*",
        "twig/extra-bundle": "^3.0",
        "twig/html-extra": "^3.0",
        "twig/intl-extra": "^3.0",
        "twig/twig": "^3.0"
    },
    "extra": {
        "doppar": {
            "providers": [
                "Doppar\\TwigBridge\\TwigLauncher"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "require-dev": {
        "phpunit/phpunit": "^13.3"
    },
    "prefer-stable": true
}